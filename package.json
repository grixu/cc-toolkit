{
  "name": "cc-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code plugin marketplace \u2014 root dev tooling (promptfoo eval suites live in plugins/<name>/evals/)",
  "scripts": {
    "eval": "bash scripts/run-evals.sh",
    "eval:data": "bash scripts/with-r2-keys.sh node scripts/eval-data.mjs",
    "eval:code-review": "bash scripts/run-evals.sh code-review",
    "eval:tester": "bash plugins/tester/evals/reset-sandbox.sh && TESTER_RUNS_DIR=\"$PWD/plugins/tester/evals/.sandbox/runs\" promptfoo eval -c plugins/tester/evals/promptfooconfig.yaml --no-cache --no-share -o /tmp/eval-tester.json",
    "eval:tester:fixture": "bash plugins/tester/evals/reset-sandbox.sh",
    "eval:tester:replay": "node plugins/tester/evals/replay.js"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "promptfoo": "0.123.1"
  }
}
