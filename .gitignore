# Node dev tooling (shared at the repo root; used by plugins/*/evals)
node_modules/
pnpm-lock.yaml
# pnpm-workspace.yaml is committed — it carries the onlyBuiltDependencies setting

# promptfoo eval outputs
eval-*.json
*.eval.json
output.json
.promptfoo/

# eval sandboxes (recreated from fixtures/ by the suite's reset script) and exported results
plugins/*/evals/.sandbox/
plugins/*/evals/.results/

# the target app's own runtime store, written on every boot
plugins/tester/evals/fixtures/target-app/state.json
