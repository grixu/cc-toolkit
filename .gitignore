# Node dev tooling (shared at the repo root; used by plugins/*/evals)
node_modules/
pnpm-lock.yaml
# pnpm-workspace.yaml is committed — it carries the onlyBuiltDependencies setting

# promptfoo eval outputs
eval-*.json
*.eval.json
output.json
.promptfoo/

# tester eval sandbox — the throwaway copy of the target app that /tester:run mutates and
# fault-injects against. state.json is the app's own runtime store, written on every boot.
plugins/tester/evals/.sandbox/
plugins/tester/evals/fixtures/target-app/state.json
