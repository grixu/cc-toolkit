{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in *.sh) shellcheck \"$f\" ;; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Running ShellCheck..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "agent-engineer@agent-engineer": true,
    "code-review@cc-toolkit": true
  },
  "extraKnownMarketplaces": {
    "agent-engineer": {
      "source": {
        "source": "github",
        "repo": "sarthakrastogi/agent-engineer"
      }
    },
    "cc-toolkit": {
      "source": {
        "source": "github",
        "repo": "grixu/cc-toolkit"
      }
    }
  }
}
