---
import Art from './Art.astro'
import Strip from './Strip.astro'
import PluginSkills from './PluginSkills.astro'
import { ui, href, langOf } from '../lib/i18n'
import { core, stageTitles, installPlugin, lineStyle, pluginPath } from '../lib/lifecycle'

const lang = langOf(Astro.url.pathname)
const t = ui[lang]
---

<ul class="cards not-content">
  {core.map((p) => (
    <li class="card card--link pcard" style={lineStyle(p.name)}>
      <Art name={p.name} class="pcard-art" />
      <div class="pcard-body">
        <p class="label">{stageTitles(p.name, lang)}</p>
        <h3 class="pcard-name"><span class="swatch" aria-hidden="true"></span><a href={href(pluginPath(p.name), lang)}>{p.name}</a></h3>
        <p class="pcard-desc">{p.desc[lang]}</p>
        <PluginSkills plugin={p.name} class="pcard-skills" />
        <div class="pcard-foot">
          <Strip cmd={installPlugin(p.name)} inCard />
          <a class="btn btn--ghost btn--sm" href={`${href('changelog/', lang)}#${p.name}`}>{t.changelog}</a>
        </div>
      </div>
    </li>
  ))}
</ul>
