---
import Badge from './Badge.astro'
import { href, langOf, fmtDate } from '../lib/i18n'
import { releases, badgeTone, pluginPath } from '../lib/lifecycle'

interface Props {
  /** Only this plugin's releases; without it, the newest across all plugins. */
  plugin?: string
  limit?: number
}
const { plugin, limit = 5 } = Astro.props
const lang = langOf(Astro.url.pathname)
const shownReleases = releases().filter((r) => !plugin || r.plugin === plugin).slice(0, limit)
---

<ol class="news not-content">
  {shownReleases.map((r) => (
    <li>
      <Badge tone={badgeTone[r.kind] ?? 'neutral'} inline={false}>{r.kind.toLowerCase()}</Badge>
      <p class="news-t">{!plugin && <><a href={href(pluginPath(r.plugin), lang)}>{r.plugin}</a>{' '}</>}<span class="tnum news-v">{r.version}</span> {r.text}</p>
      <time class="caption tnum" datetime={r.date}>{fmtDate(r.date, lang, plugin ? 'long' : 'short')}</time>
    </li>
  ))}
</ol>
