---
import Cmd from './Cmd.astro'
import Badge from './Badge.astro'
import { ui, href, langOf } from '../lib/i18n'
import { skills, stages, pluginByName, stagePath, stageById, shortName, pluginPath, pluginsIn, type StageId } from '../lib/lifecycle'

interface Props {
  /** One stage's commands; without it, one row per stage. */
  stage?: StageId
  n?: number
}
const { stage, n = 1 } = Astro.props
const lang = langOf(Astro.url.pathname)
const t = ui[lang]
const pl = lang === 'pl'
const id = `stage-table-${stage ?? 'all'}`
const here = stage ? skills.filter((k) => k.stage === stage) : []
const stageTitle = stage && stageById[stage].title[lang]
const caption = stage
  ? pl ? `Komendy na etapie ${stageTitle}` : `Commands in the ${stageTitle} stage`
  : pl ? 'Etapy i pluginy, które na nich działają' : 'The stages and the plugins that work in each'
---

<div class="table-wrap not-content" role="region" tabindex="0" aria-labelledby={id}>
  {stage ? (
    <table>
      <thead><tr><th scope="col">{t.command}</th><th scope="col">{pl ? 'Co robi' : 'What it does'}</th><th scope="col">Plugin</th></tr></thead>
      <tbody>
        {here.map((k) => (
          <tr>
            <td><a href={href(k.href, lang)}>{k.auto ? shortName(k) : <code><Cmd text={k.cmd} /></code>}</a>{k.auto && <> <Badge>{pl ? 'automatycznie' : 'automatic'}</Badge></>}{k.calledBy && <> <Badge>{pl ? 'przez' : 'via'} {k.calledBy}</Badge></>}</td>
            <td>{k.does[lang]}</td>
            <td><a href={href(pluginPath(k.plugin), lang)}>{k.plugin}</a>{!pluginByName[k.plugin].core && <span class="muted"> · {t.supporting}</span>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <table>
      <thead><tr><th scope="col">{pl ? 'Etap' : 'Stage'}</th><th scope="col">{pl ? 'Co się dzieje' : 'What happens'}</th><th scope="col">{t.plugins}</th></tr></thead>
      <tbody>
        {stages.map((s) => (
          <tr>
            <td><a href={href(stagePath(s.id), lang)}><span class="tnum">{s.n}</span> {s.title[lang]}</a></td>
            <td>{s.blurb[lang]}</td>
            <td>{pluginsIn(s.id).map((p, i) => <>{i > 0 && ', '}<a href={href(pluginPath(p), lang)}>{p}</a></>)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</div>
<p class="caption table-caption" id={id}>
  {t.table} {n}. {caption}
</p>
