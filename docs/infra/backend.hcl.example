# Copy to backend.hcl (gitignored). The R2 credentials stay out of this file: pass them as
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_ENDPOINT_URL_S3, because Terraform copies
# -backend-config values into .terraform/.
bucket                      = "grixu-infra"
key                         = "cc-toolkit-docs/terraform.tfstate"
region                      = "auto"
use_lockfile                = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
